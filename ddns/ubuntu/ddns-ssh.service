[Unit]
Description=DDNS auto updater for nftables
ConditionFileIsExecutable=/usr/local/bin/nstlddns
Wants=network-online.target
After=network-online.target nftables.service

[Service]
StartLimitInterval=5
StartLimitBurst=10
ExecStart=/usr/local/bin/nstlddns "-c" "/etc/nstl.ddns.json" "-l" "/var/log/nstlddns.log"
WorkingDirectory=/etc/controld
Restart=always
RestartSec=120
KillMode=process

[Install]
WantedBy=multi-user.target
